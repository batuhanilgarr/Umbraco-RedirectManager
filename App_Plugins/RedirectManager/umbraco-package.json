{
  "$schema": "../../umbraco-package-schema.json",
  "name": "8Bitiz.RedirectManager",
  "version": "1.2.2",
  "extensions": [
    {
      "type": "section",
      "alias": "RedirectManager.Section",
      "name": "Redirect Manager Section",
      "weight": -1000,
      "meta": {
        "label": "Redirects",
        "pathname": "redirect-manager",
        "description": "Manage URL redirects"
      }
    },
    {
      "type": "dashboard",
      "alias": "redirectManager.dashboard",
      "name": "Redirect Manager Dashboard",
      "element": "/App_Plugins/RedirectManager/redirect-dashboard.js?v=1.2.2",
      "elementName": "redirect-manager-dashboard",
      "weight": 10,
      "meta": {
        "label": "Redirect Manager",
        "description": "URL yönlendirmelerini yönetin. 301, 302, 404 ve 410 status kodlarını destekler.",
        "pathname": "redirect-manager"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "RedirectManager.Section"
        }
      ]
    }
  ]
}
