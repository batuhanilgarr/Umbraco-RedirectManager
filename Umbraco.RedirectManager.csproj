<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    
    <!-- Package Info -->
    <PackageId>BT.RedirectManager</PackageId>
    <Version>1.8.0</Version>
    <Authors>BT</Authors>
    <Company>BT</Company>
    <Description>A URL redirect manager plugin for Umbraco CMS 13, 17, and 18. Supports 301, 302, 404, and 410 status codes with backoffice management, domain-scoped redirects, windowed (7d/30d) hit-count analytics, A/B testing, scheduled CSV backups, and automatic 404 logging.</Description>
    <PackageTags>umbraco;umbraco-marketplace;plugin;redirect;seo;301;302;404;410</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/batuhanilgarr/Umbraco-RedirectManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/batuhanilgarr/Umbraco-RedirectManager</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>assets/bitiz_redirect_logo.png</PackageIcon>
    
    <!-- Content files -->
    <ContentTargetFolders>.</ContentTargetFolders>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Exclude the sibling test project's files (including its generated obj/bin output)
       from this project's default SDK item globs. Because this csproj lives at the repo
       root, the default "**/*.cs" Compile glob would otherwise also pick up files under
       Umbraco.RedirectManager.Tests/ (its own bin/obj exclusion only covers this project's
       own output directories, not a nested sibling project's). -->
  <ItemGroup>
    <Compile Remove="Umbraco.RedirectManager.Tests/**" />
    <Content Remove="Umbraco.RedirectManager.Tests/**" />
    <EmbeddedResource Remove="Umbraco.RedirectManager.Tests/**" />
    <None Remove="Umbraco.RedirectManager.Tests/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms" Version="17.1.0" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="17.1.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms" Version="13.9.2" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="13.9.2" />
  </ItemGroup>

  <!-- Include App_Plugins for backoffice UI -->
  <ItemGroup>
    <None Include="assets/bitiz_redirect_logo.png" Pack="true" PackagePath="assets\" />
    <Content Include="App_Plugins\**\*" Pack="true" PackagePath="contentFiles\any\any\App_Plugins" CopyToOutputDirectory="PreserveNewest">
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="umbraco-marketplace.json" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="App_Plugins\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>App_Plugins\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <!-- Include .targets file for auto-copy App_Plugins -->
  <ItemGroup>
    <None Include="build\BT.RedirectManager.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <!-- Sync Version from csproj to umbraco-package.json (version + element ?v=) before Build -->
  <Target Name="UpdateUmbracoPackageVersion" BeforeTargets="Build" Condition="'$(Version)' != ''">
    <PropertyGroup>
      <_UmbracoPackageJsonPath>$(ProjectDir)App_Plugins/RedirectManager/umbraco-package.json</_UmbracoPackageJsonPath>
      <_UmbracoPackageJsonContent>$([System.IO.File]::ReadAllText($(_UmbracoPackageJsonPath)))</_UmbracoPackageJsonContent>
      <_UmbracoPackageJsonVersionReplaced>$([System.Text.RegularExpressions.Regex]::Replace($(_UmbracoPackageJsonContent), '&quot;version&quot;:\s*&quot;[^&quot;]*&quot;', '&quot;version&quot;: &quot;$(Version)&quot;'))</_UmbracoPackageJsonVersionReplaced>
      <_UmbracoPackageJsonElementReplaced>$([System.Text.RegularExpressions.Regex]::Replace($(_UmbracoPackageJsonVersionReplaced), 'redirect-dashboard\.js\?v=[^&quot;&amp;]*', 'redirect-dashboard.js?v=$(Version)'))</_UmbracoPackageJsonElementReplaced>
    </PropertyGroup>
    <WriteLinesToFile File="$(_UmbracoPackageJsonPath)" Lines="$(_UmbracoPackageJsonElementReplaced)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
