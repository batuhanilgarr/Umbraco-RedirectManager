<?xml version="1.0" encoding="utf-8"?>
<!-- Push script (push-to-feed.sh) bu config'i kullanır; HTTP BaGet kaynağına izin verir. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="RedirectManagerNuGet" value="http://localhost:5555/v3/index.json" allowInsecureConnections="true" />
  </packageSources>
</configuration>
