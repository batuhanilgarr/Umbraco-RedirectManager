    <readme>README.md</readme>
    <projectUrl>https://github.com/yourusername/Umbraco.RedirectManager</projectUrl>
    <description>A URL redirect manager plugin for Umbraco CMS 17 LTS. Supports 301, 302, 404, and 410 status codes with backoffice management.</description>
    <tags>umbraco plugin redirect seo 301 302 404 410</tags>
    <repository type="git" url="https://github.com/yourusername/Umbraco.RedirectManager" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Umbraco.Cms" version="17.1.0" exclude="Build,Analyzers" />
        <dependency id="Umbraco.Cms.Infrastructure" version="17.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
